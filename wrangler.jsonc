{
  "name": "notifications",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "queues": {
    "producers": [{ "binding": "EMAIL_QUEUE", "queue": "notifications-email" }],
    "consumers": [{ "queue": "notifications-email", "max_retries": 3 }]
  },
  "vars": {
    "SMTP_HOST": "smtp-relay.brevo.com",
    "SMTP_PORT": "587",
    "APP_EMAIL_SENDER": "jude.nitram08@gmail.com",
    "APP_EMAIL_SENDER_NAME": "Bren Raphael's"
  }
  // Secrets (set with `wrangler secret put`): SMTP_USER, SMTP_PASSWORD, DATABASE_URL, API_TOKEN
}
