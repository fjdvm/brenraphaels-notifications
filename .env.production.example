MARKETING_EMAIL_SENDER=verified-sender@example.com
MARKETING_EMAIL_SENDER_NAME=Bren Raphael's
API_TOKEN=replace-with-at-least-16-characters
GATEWAY_SECRET=replace-with-at-least-16-characters
MARKETING_MAX_RECIPIENTS=100
